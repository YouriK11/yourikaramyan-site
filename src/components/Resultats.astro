---
// "Mes résultats", right after "À propos": the strongest figures, counting up once in view (Youri, 26/10/2026).
// Values from src/data/projets.ts (validated in docs/suivi.md), with labels written for the home page.
import Chiffres from './Chiffres.astro';
import { CHIFFRES_APPLICATION, CLIENTS_FREELANCE, type Chiffre } from '../data/projets';

const chiffres: Chiffre[] = [
  { ...CHIFFRES_APPLICATION.lancement, libelle: 'inscrits le jour du lancement de mon application' },
  { ...CHIFFRES_APPLICATION.attente, libelle: "inscrits sur la liste d'attente" },
  { ...CHIFFRES_APPLICATION.vues, libelle: 'de vues TikTok' },
  { ...CHIFFRES_APPLICATION.abonnes, libelle: 'abonnés TikTok' },
  { ...CLIENTS_FREELANCE, libelle: 'clients environ accompagnés en freelance' },
];
---

<section id="resultats" class="section resultats" aria-labelledby="titre-resultats">
  <div class="conteneur">
    <h2 id="titre-resultats" class="titre-section">Mes résultats</h2>
    <div class="resultats__chiffres">
      <Chiffres chiffres={chiffres} theme="clair" releve="Vues TikTok relevées le 25 octobre 2026, abonnés TikTok le 17 octobre 2026." />
    </div>
  </div>
</section>

<style>
  .resultats__chiffres {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
</style>
