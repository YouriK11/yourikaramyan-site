---
// "Projets" on the home page: one card per project (src/data/projets.ts), with a visual, the dates, the title, Youri's
// role and one result. The whole card leads to the project's page (/projets/<slug>/): the title holds the link, and
// its ::after covers the card, so screen readers hear one link per card. The visual is decorative (empty alt): the
// project page describes the same images.
import { Picture } from 'astro:assets';
import { PROJETS, lienProjet } from '../data/projets';
import { typo } from '../data/typographie';
---

<section id="projets" class="section sur-nuit projets" aria-labelledby="titre-projets">
  <div class="conteneur">
    <h2 id="titre-projets" class="titre-section">Projets</h2>

    <ul class="cartes" role="list">
      {
        PROJETS.map((p) => (
          <li class="carte">
            <div class:list={['carte__visuel', { 'carte__visuel--logo': 'image' in p.carte && p.carte.logo }]} aria-hidden="true">
              {'image' in p.carte ? (
                <Picture
                  class="carte__image"
                  src={p.carte.image}
                  alt=""
                  formats={['avif', 'webp']}
                  width={p.carte.logo ? 600 : 1080}
                  widths={p.carte.logo ? [240, 360, 480, 600] : [360, 480, 720, 1080]}
                  sizes={p.carte.logo ? '(min-width: 48em) 18rem, 14rem' : '(min-width: 75em) 37rem, (min-width: 48em) 46vw, 92vw'}
                  loading="lazy"
                  style={p.carte.cadrage ? `object-position: ${p.carte.cadrage}` : undefined}
                />
              ) : (
                <p class="carte__mots">
                  {p.carte.mots.map((mot) => (
                    <span>{mot}</span>
                  ))}
                </p>
              )}
            </div>
            <div class="carte__texte">
              <p class="carte__periode" set:html={typo(p.periode)} />
              <h3 class="carte__titre">
                <a class="carte__lien" href={lienProjet(p.slug)} set:html={typo(p.titre)} />
              </h3>
              <p class="carte__role" set:html={typo(p.role)} />
              <p class="carte__resultat" set:html={typo(p.resultat)} />
              <span class="carte__voir" aria-hidden="true">
                Voir le projet
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cartes {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .carte {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--rayon);
    background: var(--nuit-clair);
  }

  /* Visual: a photo or a screenshot cropped to 16:10, a logo on white, or the services in words */
  .carte__visuel {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0d1233;
  }

  .carte__visuel--logo {
    display: grid;
    place-items: center;
    background: var(--blanc);
  }

  /* The <picture> fills the frame, so the image's height and object-position apply */
  .carte__visuel :global(picture) {
    display: block;
    height: 100%;
  }

  .carte__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carte__visuel--logo :global(picture) {
    display: grid;
    place-items: center;
  }

  .carte__visuel--logo .carte__image {
    width: auto;
    height: 78%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .carte__mots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding-inline: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    font-family: var(--police-titre);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 780;
    font-stretch: 85%;
    line-height: 1.02;
  }

  .carte__mots span:nth-child(odd) {
    color: var(--abricot);
  }

  .carte__texte {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .carte__periode {
    color: var(--abricot);
    font-family: var(--police-titre);
    font-size: var(--texte-m);
    font-weight: 720;
  }

  .carte__titre {
    font-family: var(--police-titre);
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 760;
    font-stretch: 90%;
    line-height: 1.05;
    text-wrap: balance;
  }

  .carte__lien {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is the link's click area, above the result line's positioned bullet */
  .carte__lien::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--rayon);
  }

  .carte__lien:focus-visible {
    outline: none;
  }

  .carte:has(.carte__lien:focus-visible) {
    outline: 3px solid var(--abricot);
    outline-offset: 3px;
  }

  .carte__role {
    color: var(--brume-sur-nuit);
    text-wrap: pretty;
  }

  .carte__resultat {
    position: relative;
    margin-top: 0.5rem;
    padding-left: 1.125rem;
    font-weight: 600;
    text-wrap: pretty;
  }

  /* Small apricot square, as the CV's bullets */
  .carte__resultat::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 1px;
    background: var(--abricot);
  }

  .carte__voir {
    margin-top: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--abricot);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .carte__voir::after {
    content: ' →';
  }

  @media (hover: hover) {
    .carte:hover .carte__titre {
      text-decoration: underline;
      text-decoration-color: var(--abricot);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.15em;
    }

    .carte:hover {
      border-color: rgb(238 154 53 / 0.6);
    }
  }

  @media (min-width: 48em) {
    .cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media print {
    .carte {
      border-color: #999;
      background: none;
    }

    .carte__visuel {
      background: none;
    }

    .carte__periode,
    .carte__mots span {
      color: #000 !important;
    }

    .carte__voir {
      display: none;
    }
  }
</style>
