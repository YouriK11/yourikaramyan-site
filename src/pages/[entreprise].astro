---
// One page per company file in src/content/entreprises/ (see docs/guide-page-entreprise.md).
// Never indexed, never listed in the menu or the sitemap.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Contact from '../components/Contact.astro';
import PiedDePage from '../components/PiedDePage.astro';
import IconeTelechargement from '../components/IconeTelechargement.astro';
import { PROFIL } from '../data/profil';
import { typo } from '../data/typographie';
import { PORTRAIT, PORTRAIT_DETOURE } from '../data/portrait';

export const getStaticPaths = (async () => {
  const entreprises = await getCollection('entreprises');
  return entreprises.map((entree) => ({ params: { entreprise: entree.id }, props: { entree } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entree } = Astro.props;
const { nom, salutation, description, apercu, accroche, idees, objetEmail } = entree.data;

// "l'équipe de Col&McArthur", "l'équipe d'Ice-Watch": elision before a vowel. The optional
// "salutation" field replaces the whole greeting when this rule reads wrong (articles, "h", ...).
const de = /^[aeiouàâäéèêëîïôöùûüœæ]/i.test(nom) ? "d'" : 'de ';
const accueil = salutation ?? `Bonjour à l'équipe ${de}${nom}`;

// The portrait sits in a watch dial (a nod to watchmaking, taken from home variant C): a fine ring and twelve
// apricot hour marks, the one at twelve o'clock longer.
const reperes = Array.from({ length: 12 }, (_, i) => ({ angle: i * 30, long: i === 0 }));

const lienEmail = `mailto:${PROFIL.contact.email}?subject=${encodeURIComponent(objetEmail)}`;

// Key figures, all validated by Youri (docs/suivi.md).
const chiffres = [
  { valeur: '+500', libelle: 'inscrits le jour du lancement de MonArc' },
  { valeur: '+1 700', libelle: "inscrits sur la liste d'attente de MonArc, avant le lancement" },
  { valeur: '1,9 M', libelle: 'de vues sur le TikTok de MonArc en 60 jours' },
  { valeur: '+21 000 €', libelle: 'de ventes pour ma boutique e-commerce de 2022' },
];

// The CV at a glance: the most relevant lines, from src/data/profil.ts, ongoing first, then by end year.
const cv = [
  { titre: PROFIL.formation[0].titre, lieu: PROFIL.formation[0].lieu, periode: PROFIL.formation[0].periode },
  { titre: `${PROFIL.experiences[0].titre}, ${PROFIL.experiences[0].structure}`, lieu: '', periode: PROFIL.experiences[0].periode },
  { titre: PROFIL.projetsAcademiques[0].titre, lieu: PROFIL.projetsAcademiques[0].lieu, periode: PROFIL.projetsAcademiques[0].periode },
  { titre: PROFIL.projetsAcademiques[1].titre, lieu: PROFIL.projetsAcademiques[1].lieu, periode: PROFIL.projetsAcademiques[1].periode },
  { titre: PROFIL.formation[1].titre, lieu: PROFIL.formation[1].lieu, periode: PROFIL.formation[1].periode },
  { titre: PROFIL.experiences[1].titre, lieu: PROFIL.experiences[1].structure.toLowerCase(), periode: PROFIL.experiences[1].periode },
  { titre: PROFIL.experiences[2].titre, lieu: PROFIL.experiences[2].structure.toLowerCase(), periode: PROFIL.experiences[2].periode },
];
---

<Base
  titre={`Youri Karamyan pour ${nom}`}
  description={description}
  image={`/og/${entree.id}.png`}
  imageAlt={`Youri Karamyan pour ${nom}. ${apercu}.`}
  noindex
>
  <Entete />
  <main id="contenu">
    <section class="lettre" aria-labelledby="titre-lettre">
      <div class="conteneur lettre__grille">
        <div class="lettre__texte">
          <h1 id="titre-lettre" class="lettre__titre" set:html={typo(accueil)} />
          <span class="lettre__trait" aria-hidden="true"></span>
          {accroche.map((paragraphe) => <p set:html={typo(paragraphe)} />)}
          <div class="lettre__actions">
            <a class="bouton" href={lienEmail}>M'écrire</a>
            <a class="bouton bouton--contour" href={PROFIL.cv.fichier} download={PROFIL.cv.nomTelechargement}>
              <IconeTelechargement />
              Télécharger mon CV
            </a>
          </div>
        </div>
        <div class="lettre__portrait cadran">
          <svg class="cadran__anneau" viewBox="0 0 200 200" aria-hidden="true">
            <circle class="cadran__cercle" cx="100" cy="100" r="98" pathLength="100" transform="rotate(-90 100 100)"
            ></circle>
            {
              reperes.map((r, i) => (
                <line
                  class="cadran__repere"
                  x1="100"
                  y1={r.long ? 4.5 : 5.5}
                  x2="100"
                  y2={r.long ? 15 : 11.5}
                  transform={`rotate(${r.angle} 100 100)`}
                  style={`--i: ${i}`}
                />
              ))
            }
          </svg>
          <div class:list={['cadran__fenetre', { 'cadran__fenetre--detoure': PORTRAIT_DETOURE }]}>
            <Picture
              class="cadran__photo"
              src={PORTRAIT}
              formats={['avif', 'webp']}
              widths={[240, 320, 480, 640, 800]}
              sizes="(min-width: 64em) 22.5rem, 9rem"
              alt="Portrait de Youri Karamyan"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section sur-nuit idees" aria-labelledby="titre-idees">
      <div class="conteneur">
        <h2 id="titre-idees" class="titre-section" set:html={typo(`Trois idées pour ${nom}`)} />
        <ol class="idees__liste" role="list">
          {
            idees.map((idee, i) => (
              <li class="idee">
                <p class="idee__numero">Idée {i + 1}</p>
                <h3 class="idee__titre" set:html={typo(idee.titre)} />
                {idee.texte.map((paragraphe) => (
                  <p class="idee__texte" set:html={typo(paragraphe)} />
                ))}
                <p class="idee__experience">
                  <span>Mon expérience&nbsp;:</span> <span set:html={typo(idee.experience)} />
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section profil" aria-labelledby="titre-profil">
      <div class="conteneur profil__grille">
        <div>
          <h2 id="titre-profil" class="titre-section">Mon profil en bref</h2>
          <p class="profil__texte">
            MonArc est une application de suivi d'habitudes. J'ai conçu le produit et piloté son développement.
          </p>
          <p class="profil__texte profil__texte--suite">
            Je parle arménien (langue maternelle), français (bilingue) et anglais (B2). J'ai le permis B et un véhicule.
          </p>
          <p class="profil__liens">
            <a class="lien" href="/#monarc">Lire l'étude de cas MonArc</a>
            <a class="lien" href="/">Voir mon site complet</a>
          </p>
        </div>
        <ul class="profil__chiffres" role="list">
          {
            chiffres.map((c) => (
              <li>
                <span class="profil__valeur">{c.valeur}</span>
                <span class="profil__libelle" set:html={typo(c.libelle)} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section section--brume cv" aria-labelledby="titre-cv">
      <div class="conteneur cv__grille">
        <div>
          <h2 id="titre-cv" class="titre-section">Mon CV</h2>
          <a class="bouton cv__bouton" href={PROFIL.cv.fichier} download={PROFIL.cv.nomTelechargement}>
            <IconeTelechargement />
            Télécharger mon CV
          </a>
        </div>
        <ol class="cv__liste" role="list">
          {
            cv.map((ligne) => (
              <li>
                <span class="cv__titre" set:html={typo(ligne.lieu ? `${ligne.titre}, ${ligne.lieu}` : ligne.titre)} />
                <span class="cv__periode" set:html={typo(ligne.periode)} />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Contact objet={objetEmail} />
  </main>
  <PiedDePage />
</Base>

<style>
  /* Letter */
  .lettre {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }

  .lettre__grille {
    display: grid;
    gap: 2rem;
  }

  .lettre__titre {
    max-width: 16ch;
    font-family: var(--police-titre);
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 6.5rem);
    font-weight: 780;
    font-stretch: 92%;
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
    /* A very long single-word name still fits on a phone */
    overflow-wrap: break-word;
  }

  .lettre__trait {
    display: block;
    width: 4rem;
    height: 6px;
    margin-block: 1.5rem 1.75rem;
    border-radius: 3px;
    background: var(--abricot);
  }

  .lettre__texte > p {
    max-width: 58ch;
    font-size: var(--texte-l);
    line-height: 1.5;
  }

  .lettre__texte > p + p {
    margin-top: 1rem;
  }

  /* No single word alone on the last line of a paragraph */
  .lettre__texte > p,
  .idee__texte,
  .idee__experience,
  .profil__texte {
    text-wrap: pretty;
  }

  .lettre__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* On phones the two buttons stack at the same full width, as on the home page */
  @media (max-width: 35.99em) {
    .lettre__actions .bouton {
      flex: 1 1 100%;
    }
  }

  .lettre__portrait {
    order: -1;
    width: 9rem;
  }

  /* The dial: a round window on the portrait, a fine navy ring and twelve apricot hour marks */
  .cadran {
    position: relative;
    aspect-ratio: 1;
  }

  .cadran__anneau {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: visible;
  }

  .cadran__cercle {
    fill: none;
    stroke: rgb(24 33 79 / 0.5);
    /* In viewBox units (about 1 px on a 22rem dial). Not non-scaling-stroke: Chrome then ignores pathLength
       for the dashes and the drawn ring stops short. */
    stroke-width: 0.6;
  }

  .cadran__repere {
    stroke: var(--abricot);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .cadran__fenetre {
    position: absolute;
    inset: 6.5%;
    overflow: hidden;
    border-radius: 50%;
    background: var(--brume);
  }

  /* Cut-out photo: on the midnight blue, with a light halo behind the shoulders */
  .cadran__fenetre--detoure {
    background:
      radial-gradient(
        ellipse 62% 56% at 55% 50%,
        rgb(238 241 248 / 0.38),
        rgb(238 241 248 / 0.15) 52%,
        rgb(238 241 248 / 0) 78%
      ),
      var(--nuit);
  }

  /* Framed on the face (right of centre in the file), standing on the bottom edge, room above the head */
  .cadran__fenetre :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cadran__fenetre--detoure :global(img) {
    top: 11%;
    height: 89%;
    object-position: 62% 100%;
  }

  /* Entrance: the ring draws itself clockwise from twelve o'clock like a sweeping hand, the hour marks follow it */
  @media (prefers-reduced-motion: no-preference) {
    .cadran__cercle {
      stroke-dasharray: 100;
      animation: cadran-aiguille 1.6s cubic-bezier(0.45, 0, 0.25, 1) both;
    }

    .cadran__repere {
      animation: cadran-repere 0.35s calc(0.1s + var(--i) * 0.11s) ease-out both;
    }
  }

  @keyframes cadran-aiguille {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes cadran-repere {
    from {
      opacity: 0;
    }
  }

  /* Ideas */
  .idees__liste {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .idee {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .idee__numero {
    color: var(--abricot);
    font-family: var(--police-titre);
    font-size: clamp(1.125rem, 0.9rem + 0.5vw, 1.5rem);
    font-weight: 760;
  }

  .idee__titre {
    margin-top: 0.5rem;
    font-family: var(--police-titre);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.75rem);
    font-weight: 740;
    font-stretch: 92%;
    line-height: 1.1;
    text-wrap: balance;
  }

  .idee__texte {
    max-width: 60ch;
    margin-top: 1rem;
  }

  .idee__experience {
    max-width: 60ch;
    margin-top: 1.25rem;
    padding: 0.875rem 1rem;
    border-left: 3px solid var(--abricot);
    background: rgb(255 255 255 / 0.05);
    color: var(--brume-sur-nuit);
  }

  .idee__experience > span:first-child {
    color: var(--blanc);
    font-weight: 600;
  }

  /* Profile */
  .profil__grille {
    display: grid;
    gap: 2.5rem;
  }

  .profil__texte {
    max-width: 52ch;
    margin-top: 2rem;
    font-size: var(--texte-l);
    line-height: 1.5;
  }

  .profil__texte--suite {
    margin-top: 1rem;
  }

  .profil__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .profil__chiffres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.25rem;
  }

  .profil__chiffres li {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 2px solid var(--nuit);
  }

  .profil__valeur {
    font-family: var(--police-titre);
    font-size: clamp(1.875rem, 0.9rem + 3.6vw, 4.5rem); /* "+21 000 €" fits its column up to 1920 px */
    font-weight: 780;
    font-stretch: 90%;
    line-height: 1;
    white-space: nowrap;
  }

  .profil__libelle {
    color: var(--ardoise);
    font-size: var(--texte-s);
    line-height: 1.4;
  }

  /* CV at a glance */
  .cv__grille {
    display: grid;
    gap: 2.5rem;
  }

  .cv__bouton {
    margin-top: 2rem;
  }

  .cv__liste li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--trait);
  }

  .cv__titre {
    font-weight: 600;
  }

  .cv__periode {
    color: var(--ardoise);
  }

  /* On phones every period sits under its title, so the list reads the same on every row */
  @media (max-width: 39.99em) {
    .cv__liste li {
      flex-direction: column;
    }
  }

  @media (min-width: 64em) {
    /* The portrait grows with the screen, like the home page's (17rem at 1024 px, 22.5rem from about 1870 px) */
    .lettre__grille {
      --portrait: clamp(17rem, 7rem + 13vw, 22.5rem);
      grid-template-columns: minmax(0, 1fr) var(--portrait);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .lettre__portrait {
      order: 0;
      width: var(--portrait);
      margin-top: 0.5rem;
    }

    .idees__liste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }

    /* The three "Mon expérience" boxes share one bottom line, whatever the length of each idea */
    .idee {
      display: flex;
      flex-direction: column;
    }

    .idee__experience {
      margin-top: auto;
    }

    .idee__texte:has(+ .idee__experience) {
      margin-bottom: 1.25rem;
    }

    .profil__grille,
    .cv__grille {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .profil__chiffres {
      margin-top: 0.5rem;
      row-gap: 2.5rem;
    }

    .profil__libelle {
      font-size: var(--texte-m);
    }
  }
</style>
