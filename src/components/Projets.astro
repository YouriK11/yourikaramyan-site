---
// "Projets": one sober card per project, with the year, the title and one sentence taken word for word from the CV.
// Youri is discreet about his personal projects (23/10/2026): no panels, no figures, no screenshots, no app name.
import { PROFIL } from '../data/profil';
import { typo } from '../data/typographie';

const [application, freelance] = PROFIL.experiences;
const [yep] = PROFIL.projetsAcademiques;

const projets = [
  { titre: application.titre, annee: application.periode, phrase: application.texte },
  { titre: freelance.titre, annee: freelance.periode, phrase: freelance.texte },
  { titre: yep.titre, annee: `${yep.lieu}, ${yep.periode}`, phrase: yep.texte },
];
---

<section id="projets" class="section sur-nuit projets" aria-labelledby="titre-projets">
  <div class="conteneur">
    <h2 id="titre-projets" class="titre-section">Projets</h2>

    <ul class="projets__liste" role="list">
      {
        projets.map((p) => (
          <li class="projet">
            <p class="projet__annee" set:html={typo(p.annee)} />
            <h3 class="projet__titre" set:html={typo(p.titre)} />
            <p class="projet__phrase" set:html={typo(p.phrase)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projets__liste {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  /* A card: a fine light outline on the midnight blue, nothing that moves */
  .projet {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--rayon);
  }

  .projet__annee {
    color: var(--abricot);
    font-family: var(--police-titre);
    font-size: var(--texte-m);
    font-weight: 720;
  }

  .projet__titre {
    font-family: var(--police-titre);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    font-weight: 760;
    font-stretch: 90%;
    line-height: 1.1;
    text-wrap: balance;
  }

  .projet__phrase {
    margin-top: 0.25rem;
    color: var(--brume-sur-nuit);
    text-wrap: pretty;
  }

  /* From tablets: the three cards side by side */
  @media (min-width: 48em) {
    .projets__liste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.5rem);
    }
  }

  /* Paper: the outline keeps the cards apart on white */
  @media print {
    .projet {
      border-color: #999;
    }
  }
</style>
