---
// Trial C, "Élégance": midnight blue, the name very large in Instrument Serif ("Youri" in italic, "Karamyan"
// upright), the other texts in Instrument Sans. A nod to fine watchmaking: the portrait sits in a dial, a thin
// ring with twelve apricot hour marks. Entrance: the ring draws itself like a sweeping hand, the hour marks
// appear one after the other, the name settles into place.
import { Picture } from 'astro:assets';
import photo from '../../assets/photos/youri-chemise-detouree.png';
import TexteEssai from './TexteEssai.astro';

// Twelve hour marks; the one at twelve o'clock is longer, as on a watch dial.
const reperes = Array.from({ length: 12 }, (_, i) => ({ angle: i * 30, long: i === 0 }));
---

<section class="essai-accueil elegance sur-nuit" aria-labelledby="titre-elegance">
  <div class="conteneur elegance__grille">
    <div class="elegance__identite">
      <h1 id="titre-elegance" class="elegance__nom">
        <span class="sr-only">Youri Karamyan</span>
        <span aria-hidden="true">
          <span class="elegance__ligne elegance__ligne--prenom">Youri</span>
          <span class="elegance__ligne">Karamyan</span>
        </span>
      </h1>
      <span class="elegance__filet" aria-hidden="true"></span>
      <TexteEssai class="elegance__texte" />
    </div>

    <div class="elegance__cadran">
      <svg class="elegance__anneau" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="elegance__cercle" cx="100" cy="100" r="98" pathLength="100" transform="rotate(-90 100 100)"></circle>
        {
          reperes.map((r, i) => (
            <line
              class="elegance__repere"
              x1="100"
              y1={r.long ? 4.5 : 5.5}
              x2="100"
              y2={r.long ? 15 : 11.5}
              transform={`rotate(${r.angle} 100 100)`}
              style={`--i: ${i}`}
            />
          ))
        }
      </svg>
      <div class="elegance__photo">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 64em) 28rem, 70vw"
          alt="Portrait de Youri Karamyan"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .elegance {
    background: var(--nuit);
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .elegance__grille {
    display: grid;
    gap: 2.5rem;
  }

  .elegance__identite {
    container-type: inline-size;
  }

  /* "Karamyan" in Instrument Serif is about --mot em wide: the name fills its column */
  .elegance__nom {
    --mot: 3.48;
    color: var(--blanc);
    font-family: var(--font-serif), Georgia, serif;
    font-size: min(calc(100cqi / var(--mot)), 16rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.015em;
  }

  .elegance__ligne {
    display: block;
    white-space: nowrap;
  }

  .elegance__ligne--prenom {
    font-style: italic;
  }

  /* A hairline, as fine as a watch hand */
  .elegance__filet {
    display: block;
    width: 6rem;
    height: 2px;
    margin-top: 1.5rem;
    background: var(--abricot);
    transform-origin: left center;
  }

  .elegance__identite :global(.elegance__texte) {
    margin-top: 2rem;
  }

  /* The dial: a round window on the portrait, a fine ring and twelve hour marks */
  .elegance__cadran {
    position: relative;
    justify-self: center;
    width: min(80vw, 24rem);
    aspect-ratio: 1;
  }

  .elegance__anneau {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: visible;
  }

  .elegance__cercle {
    fill: none;
    stroke: rgb(238 241 248 / 0.45);
    /* In viewBox units (about 1 px on a 30rem dial). Not non-scaling-stroke: Chrome then ignores pathLength
       for the dashes and the drawn ring stops short. */
    stroke-width: 0.5;
  }

  .elegance__repere {
    stroke: var(--abricot);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .elegance__photo {
    position: absolute;
    inset: 6.5%; /* the lower hour marks stay on the midnight blue, off the white shirt */
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, #26306a, var(--nuit) 70%);
  }

  .elegance__photo :global(img) {
    position: absolute;
    left: 50%;
    top: 6%;
    width: 92%;
    height: auto;
    transform: translateX(-46%);
  }

  /* Entrance: the ring draws itself clockwise like a sweeping hand, the hour marks follow it,
     the name settles into place (visible from the first frame). */
  @media (prefers-reduced-motion: no-preference) {
    .elegance__cercle {
      stroke-dasharray: 100;
      animation: elegance-aiguille 1.6s cubic-bezier(0.45, 0, 0.25, 1) both;
    }

    .elegance__repere {
      animation: elegance-repere 0.35s calc(0.1s + var(--i) * 0.11s) ease-out both;
    }

    .elegance__ligne {
      animation: elegance-poser 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .elegance__ligne + .elegance__ligne {
      animation-delay: 0.1s;
    }

    .elegance__filet {
      animation: elegance-filet 1s 0.5s cubic-bezier(0.6, 0, 0.2, 1) both;
    }
  }

  @keyframes elegance-aiguille {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes elegance-repere {
    from {
      opacity: 0;
    }
  }

  @keyframes elegance-poser {
    from {
      transform: translateY(0.12em);
    }
  }

  @keyframes elegance-filet {
    from {
      transform: scaleX(0);
    }
  }

  /* Desktop: the whole first screen, the name and the dial side by side, with no gap between them */
  @media (min-width: 64em) {
    .elegance {
      display: grid;
      align-content: center;
      min-height: calc(100svh - var(--hauteur-entete));
      padding-block: 2.5rem;
    }

    .elegance .conteneur {
      --largeur: 80rem;
    }

    .elegance__grille {
      --cadran: min(30rem, 36vw, calc((100svh - var(--hauteur-entete)) * 0.62));
      /* The name column is exactly as wide as the name (or the text block): no gap before the dial */
      grid-template-columns:
        minmax(0, max(40rem, calc(3.48 * min(16rem, max(5.5rem, (100svh - var(--hauteur-entete) - 22rem) / 1.85)))))
        var(--cadran);
      justify-content: center;
      align-items: center;
      column-gap: clamp(2rem, 3vw, 3.5rem);
    }

    .elegance__nom {
      font-size: min(calc(100cqi / var(--mot)), 16rem, max(5.5rem, calc((100svh - var(--hauteur-entete) - 22rem) / 1.85)));
    }

    .elegance__cadran {
      width: var(--cadran);
    }
  }
</style>
