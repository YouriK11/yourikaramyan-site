---
// Skills, languages and practical details, worded exactly as on the CV (src/data/profil.ts).
import { PROFIL } from '../data/profil';
import { typo } from '../data/typographie';

// "Réseaux sociaux (TikTok, Instagram), création de contenu" -> items, keeping commas inside brackets.
const elements = (detail: string) => detail.split(/,(?![^(]*\))/).map((s) => s.trim());
const majuscule = (texte: string) => texte.charAt(0).toUpperCase() + texte.slice(1);
---

<section id="competences" class="section section--brume competences" aria-labelledby="titre-competences">
  <div class="conteneur competences__grille">
    <h2 id="titre-competences" class="titre-section">Compétences et langues</h2>

    <div class="competences__groupes">
      {
        PROFIL.competences.map((c) => (
          <div class="groupe">
            <h3 class="groupe__titre">{c.groupe}</h3>
            <ul class="groupe__elements" role="list">
              {elements(c.detail).map((e) => (
                <li set:html={typo(majuscule(e))} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="competences__cote">
      <div>
        <h3 class="groupe__titre">Langues</h3>
        <dl class="langues">
          {
            PROFIL.langues.map((l) => (
              <div>
                <dt>{l.langue}</dt>
                <dd>{l.niveau}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h3 class="groupe__titre">Intérêts</h3>
        <p class="interets" set:html={typo(`${PROFIL.interets}.`)} />
      </div>
    </div>
  </div>
</section>

<style>
  .competences__grille {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .competences__groupes {
    display: grid;
    gap: 2rem;
  }

  .groupe {
    padding-top: 1.25rem;
    border-top: 2px solid var(--nuit);
  }

  .groupe__titre {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .groupe__elements {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .groupe__elements li {
    position: relative;
    padding-left: 1.125rem;
  }

  .groupe__elements li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 1px;
    background: var(--abricot);
  }

  .competences__cote {
    display: grid;
    gap: 2.25rem;
  }

  .competences__cote > div {
    padding-top: 1.25rem;
    border-top: 2px solid var(--nuit);
  }

  .langues {
    display: grid;
    margin-top: 0.75rem;
  }

  .langues > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--trait);
  }

  .langues > div:last-child {
    border-bottom: 0;
  }

  .langues dt {
    font-weight: 600;
  }

  .langues dd {
    margin: 0;
    color: var(--ardoise);
  }

  .interets {
    margin-top: 0.75rem;
  }

  @media (min-width: 48em) {
    .competences__groupes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }

  @media (min-width: 64em) {
    .competences__grille {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .competences__grille > .titre-section {
      grid-column: 1 / -1;
    }
  }
</style>
