---
// Site header. Desktop: monogram, section links, CV button.
// Mobile: monogram and a "Menu" button that opens a full-screen panel (native popover, works without JS).
import { PROFIL } from '../data/profil';
import IconeTelechargement from './IconeTelechargement.astro';

const liens = [
  { href: '/#a-propos', texte: 'À propos' },
  { href: '/#projets', texte: 'Projets' },
  { href: '/#parcours', texte: 'Parcours' },
  { href: '/#competences', texte: 'Compétences' },
  { href: '/#contact', texte: 'Contact' },
];
---

<header class="entete">
  <div class="conteneur entete__barre">
    <a class="monogramme" href="/" aria-label="YK, accueil de Youri Karamyan">
      <span aria-hidden="true">YK</span>
    </a>

    <nav class="entete__nav" aria-label="Sections">
      <ul role="list">
        {
          liens.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
      <a class="bouton bouton--petit" href={PROFIL.cv.fichier} download={PROFIL.cv.nomTelechargement}>
        <IconeTelechargement />
        Télécharger mon CV
      </a>
    </nav>

    <button class="entete__menu" type="button" popovertarget="menu-mobile">
      Menu
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="menu-mobile" class="menu-mobile sur-nuit" popover>
    <div class="conteneur menu-mobile__contenu">
      <div class="menu-mobile__haut">
        <span class="monogramme" aria-hidden="true">YK</span>
        <button class="entete__menu" type="button" popovertarget="menu-mobile" popovertargetaction="hide" autofocus>
          Fermer
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Menu">
        <ul role="list" class="menu-mobile__liens">
          {
            liens.map((lien) => (
              <li>
                <a href={lien.href}>{lien.texte}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-mobile__bas">
        <a class="bouton bouton--abricot" href={PROFIL.cv.fichier} download={PROFIL.cv.nomTelechargement}>
          <IconeTelechargement />
          Télécharger mon CV
        </a>
        <a class="lien" href={`mailto:${PROFIL.contact.email}`}>{PROFIL.contact.email}</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Home page: the link of the section in view is marked (aria-current), with the same fixed apricot stroke as on
  // hover. A section counts as "in view" when it crosses a thin band a third of the way down the screen.
  const liensSections = Array.from(document.querySelectorAll<HTMLAnchorElement>('.entete a[href^="/#"]'));
  const sections = [...new Set(liensSections.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  if (location.pathname === '/' && sections.length && 'IntersectionObserver' in window) {
    const visibles = new Map<string, boolean>();
    const marquer = (id: string | undefined) =>
      liensSections.forEach((a) =>
        a.hash === `#${id}` ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current'),
      );
    // At the bottom of the page (footer in view), the last section counts as current: on tall screens it never
    // reaches the band.
    let finDePage = false;
    const choisir = () =>
      marquer(finDePage ? sections[sections.length - 1].id : sections.find((section) => visibles.get(section.id))?.id);
    const observateur = new IntersectionObserver(
      (entrees) => {
        entrees.forEach((entree) => visibles.set(entree.target.id, entree.isIntersecting));
        choisir();
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observateur.observe(section));
    const pied = document.querySelector('.pied');
    if (pied) {
      new IntersectionObserver(([entree]) => {
        finDePage = entree.isIntersecting;
        choisir();
      }).observe(pied);
    }
  }

  const menu = document.getElementById('menu-mobile');
  if (menu && 'hidePopover' in menu) {
    // Close the mobile panel when a section link is chosen.
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a[href^="/#"]')) {
        menu.hidePopover();
      }
    });

    // While the full-screen panel is open, the page behind it is out of reach for keyboard and screen readers.
    const arrierePlan = document.querySelectorAll<HTMLElement>('.lien-evitement, .entete__barre, main, .pied');
    const figer = (oui: boolean) => arrierePlan.forEach((el) => (el.inert = oui));
    // Set inert after opening: the browser has already saved "Menu" as the element to refocus.
    menu.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') figer(true);
    });
    // Remove inert before closing, so focus can return to "Menu".
    menu.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState === 'closed') figer(false);
    });

    // The desktop layout hides the panel: close it for real.
    // Same breakpoint as the CSS below: five links and the CV button need about 1024 px.
    const bureau = window.matchMedia('(min-width: 64em)');
    bureau.addEventListener('change', () => {
      if (bureau.matches && menu.matches(':popover-open')) menu.hidePopover();
    });
  }
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--blanc);
    border-bottom: 1px solid var(--trait);
  }

  .entete__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--hauteur-entete);
  }

  .monogramme {
    position: relative;
    display: inline-block;
    padding-bottom: 0.4rem;
    font-family: var(--police-titre);
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .monogramme::after {
    content: '';
    position: absolute;
    left: 0.05em;
    bottom: 0;
    width: 0.8em;
    height: 4px;
    border-radius: 2px;
    background: var(--abricot);
  }

  .entete__nav {
    display: none;
  }

  .entete__nav ul {
    display: flex;
    gap: 1.75rem;
  }

  /* Hover: an apricot stroke draws itself under the link (drawn as a background, so nothing moves) */
  .entete__nav ul a {
    display: inline-block;
    white-space: nowrap;
    padding: 0.375rem 0.5rem;
    margin-inline: -0.5rem;
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--abricot), var(--abricot)) no-repeat left bottom / 0 2px;
    background-origin: content-box;
    background-clip: content-box;
  }

  /* Mouse only: after a tap on a tablet, the stroke would stay under the link */
  @media (hover: hover) {
    .entete__nav ul a:hover {
      background-size: 100% 2px;
    }
  }

  /* The section in view (home page): the stroke stays */
  .entete__nav ul a[aria-current] {
    background-size: 100% 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .entete__nav ul a {
      transition: background-size 0.25s ease;
    }
  }

  .entete__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 2px solid currentColor;
    border-radius: var(--rayon-s);
    background: transparent;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .entete__menu svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Without the Popover API the panel cannot open: hide its button. */
  @supports not selector(:popover-open) {
    .entete__menu {
      display: none;
    }
  }

  /* Full menu from 64em: five links and the CV button need the room (tablets keep the "Menu" button) */
  @media (min-width: 64em) {
    .entete__nav {
      display: flex;
      align-items: center;
      gap: 2.25rem;
    }

    .entete__menu {
      display: none;
    }
  }

  /* Mobile panel */
  .menu-mobile {
    /* Hidden by default, also in browsers without the Popover API (iOS 16, Firefox ESR 115). */
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
  }

  .menu-mobile:popover-open {
    display: block;
  }

  .menu-mobile__contenu {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: 2rem;
  }

  .menu-mobile__haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--hauteur-entete);
  }

  .menu-mobile__liens {
    display: grid;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .menu-mobile__liens a {
    display: inline-block;
    padding-block: 0.25rem;
    font-family: var(--police-titre);
    font-size: clamp(2.25rem, 10vw, 3rem);
    font-weight: 760;
    font-stretch: 92%;
    line-height: 1.1;
    text-decoration: none;
  }

  /* The section in view (home page): an apricot underline, as in the desktop menu */
  .menu-mobile__liens a[aria-current] {
    text-decoration-line: underline;
    text-decoration-color: var(--abricot);
    text-decoration-thickness: 4px;
    text-underline-offset: 0.18em;
  }

  .menu-mobile__bas {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 3rem;
  }

  @media (max-width: 47.99em) {
    :global(html:has(.menu-mobile:popover-open)) {
      overflow: hidden;
    }
  }

  @media (min-width: 64em) {
    .menu-mobile:popover-open {
      display: none;
    }
  }
</style>
