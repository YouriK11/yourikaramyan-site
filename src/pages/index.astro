---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Youri Karamyan</title>
		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-content: center;
				padding: 16px;
				background: #ffffff;
				color: #18214f;
				font-family: system-ui, sans-serif;
			}
			h1 {
				margin: 0;
				font-size: clamp(2.5rem, 12vw, 6rem);
				line-height: 1;
			}
			p {
				margin: 1rem 0 0;
				color: #5b6386;
			}
			span {
				display: block;
				width: 4rem;
				height: 6px;
				margin-top: 1rem;
				border-radius: 3px;
				background: #ee9a35;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Youri<br />Karamyan</h1>
			<span aria-hidden="true"></span>
			<p>Le site est en préparation.</p>
		</main>
	</body>
</html>
