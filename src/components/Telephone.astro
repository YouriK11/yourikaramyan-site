---
// A phone frame drawn in CSS around a real screenshot. The image keeps its own proportions,
// and its width/height attributes reserve the space before it loads (no layout shift).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { typo } from '../data/typographie';

interface Props {
  src: ImageMetadata;
  alt: string;
  legende?: string;
  /** Rendered width, for the browser to pick the right file. */
  sizes?: string;
  /** Camera pill: only for screenshots that include the phone's status bar. */
  camera?: boolean;
}

// Desktop: a quarter of the 72rem container minus the gaps, about 251px wide.
const { src, alt, legende, sizes = '(min-width: 64em) 16rem, min(62vw, 15rem)', camera = true } = Astro.props;
---

<figure class="telephone">
  <div class:list={['telephone__cadre', { 'telephone__cadre--camera': camera }]}>
    <Picture
      class="telephone__ecran"
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      width={600}
      widths={[240, 360, 480, 600]}
      sizes={sizes}
      loading="lazy"
    />
  </div>
  {legende && <figcaption class="telephone__legende" set:html={typo(legende)} />}
</figure>

<style>
  .telephone {
    margin: 0;
  }

  .telephone__cadre {
    position: relative;
    padding: 0.4rem;
    border-radius: 2.1rem;
    background: #0d1233;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  /* Camera pill, centered between the clock and the battery of the screenshot */
  .telephone__cadre--camera::after {
    content: '';
    position: absolute;
    top: 3.2%;
    left: 50%;
    width: 27%;
    height: 2.4%;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  .telephone__ecran {
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
  }

  /* Desktop hover: the phone lifts by a few pixels (transform only, nothing else moves).
     From 64em only: below, the swipeable row clips anything that rises above it. */
  @media (hover: hover) and (min-width: 64em) and (prefers-reduced-motion: no-preference) {
    .telephone__cadre {
      transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .telephone:hover .telephone__cadre {
      transform: translateY(-6px);
    }
  }

  @media print {
    .telephone {
      break-inside: avoid;
    }
  }

  .telephone__legende {
    margin-top: 0.875rem;
    color: var(--brume-sur-nuit);
    font-size: var(--texte-s);
    line-height: 1.4;
  }
</style>
