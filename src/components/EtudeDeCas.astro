---
// Case study: MonArc, shown inside its panel of the "Projets" section (src/components/Projets.astro).
// The panel's summary already gives the title, the year and Youri's role sentence.
// Every fact and figure comes from docs/suivi.md (validated by Youri).
// Other users' photos and first names are blurred in src/assets/monarc (originals stay in sources/).
import Telephone from './Telephone.astro';
import Compteur from './Compteur.astro';
import { PROFIL } from '../data/profil';
import { typo } from '../data/typographie';

import ecranFil from '../assets/monarc/app-fil.jpg';
import ecranClassement from '../assets/monarc/app-classement.jpg';
import ecranProfil from '../assets/monarc/app-profil.jpg';
import grilleInstagram from '../assets/monarc/instagram-grille.jpg';
import statsTiktok from '../assets/monarc/tiktok-stats.jpg';

// Key results, shown very large at the top of the case study. All validated by Youri (docs/suivi.md).
const resultats = [
  { valeur: 500, prefixe: '+', libelle: 'inscrits le jour du lancement' },
  { valeur: 1700, prefixe: '+', libelle: "inscrits sur la liste d'attente, avant le lancement" },
  // Usage of the app: "20e sur 1 056 cette semaine" on Youri's "Aujourd'hui" screen (Youri, 21/10/2026).
  { valeur: 1000, prefixe: '+', libelle: 'participants dans le classement de la semaine, au 21 octobre 2026' },
  { valeur: 1.9, decimales: 1, suffixe: ' M', libelle: 'vues sur TikTok en 60 jours' },
  { valeur: 6500, prefixe: '+', libelle: 'abonnés sur TikTok' },
  { valeur: 170000, prefixe: '+', libelle: "j'aime sur le compte TikTok" },
];

// The app's three screens, fanned out: the feed in front, the ranking and the profile behind it.
const eventail = [
  {
    cote: 'gauche',
    position: 'à gauche',
    src: ecranClassement,
    alt: 'Écran Classement de MonArc : le classement de la semaine, avec le grade et les points de chaque participant.',
    legende: 'Le classement de la semaine',
  },
  {
    cote: 'centre',
    position: 'au centre',
    src: ecranFil,
    alt: "Écran Fil de MonArc : la preuve photo d'une séance de musculation publiée par un participant.",
    legende: 'Le fil des preuves photo',
  },
  {
    cote: 'droite',
    position: 'à droite',
    src: ecranProfil,
    alt: 'Écran Profil de MonArc : grade Apprenti, 940 points et progression vers le grade suivant.',
    legende: 'Le profil, les points et les grades',
  },
];

// Rendered width of the fanned phones (see --largeur-tel below), for the browser to pick the right file.
const TAILLES_EVENTAIL =
  '(min-width: 90em) 22rem, (min-width: 80em) 21rem, (min-width: 64em) 19rem, (min-width: 48em) 17rem, 15rem';

const etapes = [
  {
    titre: 'Concevoir le produit',
    // Youri's role sentence is in the panel's summary just above: it appears once.
    texte: ["L'application combine la preuve en photo, un classement chaque semaine, six grades et des arcs privés."],
  },
  {
    titre: "Constituer la liste d'attente",
    texte: [
      "Avant le lancement, j'ai constitué une liste d'attente de plus de 1 700 inscrits.",
      "Je l'anime par e-mail.",
    ],
  },
  {
    titre: "Lancer l'application",
    texte: [
      "MonArc est sortie le 1er octobre 2026 sur l'App Store et en version web.",
      'Plus de 500 personnes se sont inscrites le jour même.',
      "L'application est aussi disponible sur Google Play.",
    ],
  },
  {
    titre: 'Animer la communauté chaque jour',
    texte: [
      'Je publie une vidéo TikTok par jour, construite à partir des preuves photo des utilisateurs.',
      'Sur Instagram, des publications régulières présentent les preuves du jour.',
    ],
  },
];
---

<div class="etude">
    <div class="etude__entete">
      <p class="etude__chapo">MonArc est une application de suivi d'habitudes.</p>
      <div class="etude__liens">
        <a class="bouton bouton--abricot" href={PROFIL.monarc.appStore}>Voir MonArc sur l'App Store</a>
        <a class="bouton bouton--abricot" href={PROFIL.monarc.googlePlay}>Voir MonArc sur Google Play</a>
        <a class="bouton bouton--contour" href={PROFIL.monarc.site}>Ouvrir {PROFIL.monarc.siteAffiche}</a>
      </div>
    </div>

    <div class="resultats">
      <h4 class="etude__soustitre">Les résultats</h4>
      <ul class="chiffres" role="list">
        {
          resultats.map((r) => (
            <li>
              <span class="chiffre__valeur">
                {r.texte ?? <Compteur valeur={r.valeur!} decimales={r.decimales} prefixe={r.prefixe} suffixe={r.suffixe} />}
              </span>
              <span class="chiffre__libelle" set:html={typo(r.libelle)} />
            </li>
          ))
        }
      </ul>
    </div>

    <!-- The site's second animated moment (after the hero): the phones spread out when the panel opens. -->
    <figure class="eventail" data-eventail>
      <div class="eventail__scene">
        {
          eventail.map((ecran) => (
            <div class={`eventail__tel eventail__tel--${ecran.cote}`}>
              <Telephone src={ecran.src} alt={ecran.alt} sizes={TAILLES_EVENTAIL} />
            </div>
          ))
        }
      </div>
      <figcaption class="eventail__legende">
        <ul class="eventail__ecrans" role="list">
          {
            eventail.map((ecran) => (
              <li class={`eventail__ecran eventail__ecran--${ecran.cote}`}>
                <span set:html={typo(ecran.legende)} />
                <span class="eventail__position"> ({ecran.position})</span>
              </li>
            ))
          }
        </ul>
      </figcaption>
    </figure>

    <div class="etude__recit">
      <div class="etude__contexte">
        <h4 class="etude__soustitre">Le contexte</h4>
        <!-- Mechanics as described on the App Store listing (checked 19/10/2026). -->
        <p>
          MonArc aide à tenir ses habitudes. Chaque participant choisit trois habitudes et leur rythme. Chaque jour, il
          valide ce qu'il a fait. Une preuve en photo lui rapporte tous les points. Un classement le compare aux autres
          participants.
        </p>
        <dl class="faits">
          <div>
            <dt>Plateformes</dt>
            <dd>App Store, Google Play et version web</dd>
          </div>
        </dl>
      </div>

      <div class="etude__actions">
        <h4 class="etude__soustitre">Ce que j'ai fait</h4>
        <ol class="etapes" role="list">
          {
            etapes.map((etape, i) => (
              <li class="etape">
                <span class="etape__numero" aria-hidden="true">
                  {i + 1}
                </span>
                <h5 class="etape__titre">{etape.titre}</h5>
                {etape.texte.map((phrase) => (
                  <p set:html={typo(phrase)} />
                ))}
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="reseaux">
      <h4 class="etude__soustitre">Sur les réseaux sociaux</h4>
      <div class="reseaux__telephones">
        <Telephone
          src={grilleInstagram}
          alt="Grille Instagram du compte @monarc_app : les publications des jours 11 à 18 du Winter Arc."
          legende="Les preuves du jour sur Instagram"
          sizes="(min-width: 64em) 21rem, (min-width: 36em) 17rem, min(62vw, 15rem)"
        />
        <Telephone
          src={statsTiktok}
          alt="Statistiques TikTok du compte @monarc_app, du 19 août au 17 octobre 2026 : 1,9 million de vues de publications."
          legende="Les statistiques TikTok sur 60 jours"
          camera={false}
          sizes="(min-width: 64em) 21rem, (min-width: 36em) 17rem, min(62vw, 15rem)"
        />
      </div>
    </div>
</div>

<script>
  // The fan spreads out when the MonArc panel opens and at least a third of it is on screen (inside a closed
  // panel nothing is rendered, so the observer only fires once the panel is open). Closing the panel gathers
  // the phones again: they spread out at every opening. Without JavaScript or with reduced motion, the phones
  // are simply shown spread out. Transforms only: nothing around the phones ever moves.
  const eventail = document.querySelector<HTMLElement>('[data-eventail]');
  if (eventail && 'IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const rassembler = () => {
      eventail.classList.remove('eventail--anime');
      eventail.classList.add('eventail--ferme');
    };
    const observateur = new IntersectionObserver(
      (entrees) => {
        if (!entrees.some((entree) => entree.isIntersecting)) return;
        observateur.unobserve(eventail);
        eventail.classList.add('eventail--anime');
        requestAnimationFrame(() => eventail.classList.remove('eventail--ferme'));
      },
      { threshold: 0.35 },
    );
    rassembler();
    observateur.observe(eventail);

    const panneau = eventail.closest('details');
    panneau?.addEventListener('toggle', () => {
      if (panneau.open) return;
      rassembler();
      observateur.observe(eventail);
    });
  }
</script>

<style>
  /* Introduction: what MonArc is, and where to find it */
  .etude__chapo {
    max-width: 40ch;
    font-size: var(--texte-l);
    line-height: 1.45;
  }

  .etude__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* On phones the buttons stack: same full width, as in the hero. */
  @media (max-width: 35.99em) {
    .etude__liens .bouton {
      flex: 1 1 100%;
    }
  }

  /* No content-visibility here on purpose: Chrome leaves skipped blocks out of the accessibility tree
     until they are scrolled into view, so screen reader users could not reach these headings. */

  /* Same size as the subheadings of the other project panels */
  .etude__soustitre {
    font-family: var(--police-titre);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 720;
    font-stretch: 92%;
    line-height: 1.15;
  }

  /* Key results: the proof, very large */
  .resultats {
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }

  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin-top: 2rem;
  }

  .chiffres li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .chiffre__valeur {
    color: var(--abricot);
    font-family: var(--police-titre);
    /* 11vw: "+170 000" still fits its column on a 320 px phone */
    font-size: min(clamp(2.75rem, 0.6rem + 5.6vw, 6rem), 11vw);
    font-weight: 780;
    font-stretch: 85%;
    line-height: 0.95;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .chiffre__libelle {
    max-width: 24ch;
    color: var(--brume-sur-nuit);
    font-size: var(--texte-m);
    line-height: 1.4;
  }

  /* Fan of phones */
  .eventail {
    --largeur-tel: clamp(15rem, 8rem + 14vw, 22rem); /* never smaller than the old 240 px screens */
    --ecart: 46%;
    --angle: 7deg;
    --recul: 0.86;
    margin: clamp(4rem, 3rem + 4vw, 7rem) 0 0;
  }

  .eventail__scene {
    position: relative;
    display: grid;
    justify-content: center;
    align-items: end;
    margin-inline: calc(-1 * var(--gouttiere));
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
    overflow-x: clip; /* the outer phones may bleed past the screen edge on phones */
  }

  /* Light halo, so the dark phones stand out from the midnight blue */
  .eventail__scene::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(170vw, 80rem);
    aspect-ratio: 1.25;
    background: radial-gradient(
      closest-side,
      rgb(238 241 248 / 0.32),
      rgb(238 241 248 / 0.18) 50%,
      rgb(238 241 248 / 0.07) 78%,
      rgb(238 241 248 / 0)
    );
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .eventail__tel {
    position: relative;
    grid-area: 1 / 1;
    width: var(--largeur-tel);
    transform-origin: 50% 100%;
  }

  .eventail__tel :global(.telephone__cadre) {
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      0 1.75rem 3.5rem -1rem rgb(4 6 22 / 0.65);
  }

  .eventail__tel--centre {
    z-index: 2;
    transform: translateY(-5%);
  }

  .eventail__tel--gauche {
    z-index: 1;
    transform: translateX(calc(-1 * var(--ecart))) rotate(calc(-1 * var(--angle))) scale(var(--recul));
  }

  .eventail__tel--droite {
    z-index: 1;
    transform: translateX(var(--ecart)) rotate(var(--angle)) scale(var(--recul));
  }

  /* Before it is seen: the three phones stacked, the outer two just peeking out */
  .eventail--ferme .eventail__tel--centre {
    transform: none;
  }

  .eventail--ferme .eventail__tel--gauche {
    transform: translateX(-9%) rotate(-1.5deg) scale(var(--recul));
  }

  .eventail--ferme .eventail__tel--droite {
    transform: translateX(9%) rotate(1.5deg) scale(var(--recul));
  }

  .eventail--ferme .eventail__scene::before {
    opacity: 0.45;
  }

  /* Slow start, soft landing: the spread reads as one gentle gesture */
  .eventail--anime .eventail__tel {
    transition: transform 1.5s cubic-bezier(0.45, 0, 0.2, 1);
  }

  .eventail--anime .eventail__tel--centre {
    transition-duration: 1.2s;
  }

  .eventail--anime .eventail__scene::before {
    transition: opacity 1.5s ease;
  }

  /* Captions: a list with positions on phones, one caption under each phone from 48em */
  .eventail__legende {
    margin-top: 0.5rem;
  }

  .eventail__ecrans {
    display: grid;
    gap: 0.25rem;
    color: var(--brume-sur-nuit);
    font-size: var(--texte-s);
    line-height: 1.4;
  }


  /* Context and steps */
  .etude__recit {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .etude__contexte > p {
    max-width: 52ch;
    margin-top: 1.25rem;
  }

  .faits {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .faits > div {
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .faits dt {
    color: var(--brume-sur-nuit);
    font-size: var(--texte-s);
  }

  .faits dd {
    margin: 0.125rem 0 0;
    font-weight: 600;
  }

  .etapes {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
  }

  .etape {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-content: start; /* steps side by side share a height: never stretch the rows */
    column-gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .etape > :not(.etape__numero) {
    grid-column: 2;
  }

  .etape__numero {
    grid-row: 1 / span 3;
    color: var(--abricot);
    font-family: var(--police-titre);
    font-size: 1.75rem;
    font-weight: 760;
    line-height: 1;
  }

  .etape__titre {
    font-size: clamp(1.125rem, 0.95rem + 0.3vw, 1.3125rem);
    font-weight: 650;
    line-height: 1.3;
  }

  .etape p {
    margin-top: 0.375rem;
    color: var(--brume-sur-nuit);
  }

  /* Social networks: the two proofs side by side */
  .reseaux {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  /* Phones: one capture under the other, as large as before the pass. From 36em: side by side. */
  .reseaux__telephones {
    display: grid;
    grid-template-columns: min(62vw, 15rem);
    gap: 2.5rem;
    align-items: end; /* both captions on one line despite the different screenshot heights */
    margin-top: 2rem;
  }

  @media (min-width: 36em) {
    .reseaux__telephones {
      grid-template-columns: repeat(2, minmax(0, 17rem));
    }
  }

  @media (min-width: 48em) {
    .eventail {
      --ecart: 64%;
      --angle: 8deg;
    }

    .chiffres {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2rem;
    }

    .etapes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }

    /* One caption under each phone: left, centre, right */
    .eventail__ecrans {
      grid-template-columns: minmax(0, 1fr) var(--largeur-tel) minmax(0, 1fr);
      column-gap: 2rem;
    }

    .eventail__ecran--gauche {
      text-align: end;
    }

    .eventail__ecran--centre {
      color: var(--blanc);
      text-align: center;
    }

    .eventail__position {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .etude__entete {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 3rem;
      align-items: end;
    }

    .etude__liens {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      margin-top: 0;
    }

    .etude__recit {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 5rem;
    }

    .etapes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }

    .reseaux {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: start;
    }

    /* Desktop: the two captures fill their column instead of leaving it half empty */
    .reseaux__telephones {
      grid-template-columns: repeat(2, minmax(0, 21rem));
      margin-top: 0;
    }
  }

  /* Paper: the phones side by side, never fanned */
  @media print {
    .eventail__scene {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .eventail__scene::before {
      display: none;
    }

    .eventail__tel {
      grid-area: auto !important;
      width: auto;
      transform: none !important;
    }

  }
</style>
