---
// Trial pages only (/essai-a, /essai-b, /essai-c): the hero texts, word for word as on the home page.
// Each variant styles them through the class it passes.
import IconeTelechargement from '../IconeTelechargement.astro';
import { PROFIL } from '../../data/profil';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
---

<div class:list={['essai-texte', classe]}>
  <div class="essai-texte__presentation">
    <p class="essai-texte__role">
      Étudiant en 3e bachelier <span class="insecable">E-Business</span> à la HEPL&nbsp;(Liège).
    </p>
    <p class="essai-texte__recherche">
      Je cherche un stage en marketing digital et <span class="insecable">e-commerce</span>.
    </p>
  </div>

  <div class="essai-texte__actions">
    <a class="bouton bouton--abricot" href={PROFIL.cv.fichier} download={PROFIL.cv.nomTelechargement}>
      <IconeTelechargement />
      Télécharger mon CV
    </a>
    <a class="bouton bouton--contour" href="/#contact">Me contacter</a>
  </div>

  <p class="essai-texte__preuve">
    MonArc, l'application que j'ai conçue, a dépassé 500&nbsp;inscrits le jour de son lancement.
    <a class="lien" href="#monarc">Lire l'étude de cas</a>
  </p>
</div>

<style>
  .essai-texte__presentation {
    display: grid;
    gap: 0.25rem;
    font-size: var(--texte-l);
    line-height: 1.45;
  }

  .essai-texte__role {
    color: var(--blanc);
    font-weight: 600;
  }

  .essai-texte__recherche {
    color: var(--brume-sur-nuit);
  }

  .essai-texte__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .essai-texte__preuve {
    max-width: 36rem;
    margin-top: 1.5rem;
    padding-top: 1.125rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    color: var(--brume-sur-nuit);
  }

  .essai-texte__preuve .lien {
    color: var(--blanc);
    font-weight: 600;
    white-space: nowrap;
  }

  /* On phones the two buttons stack, as on the home page */
  @media (max-width: 35.99em) {
    .essai-texte__actions .bouton {
      flex: 1 1 100%;
    }
  }
</style>
