---
// "À propos": Youri's own text, word for word, in two paragraphs (26/10/2026).
import { typo } from '../data/typographie';

const paragraphes = [
  "Le digital m'intéresse autant pour sa créativité que pour son potentiel commercial.",
  "Étudiant en E-Business, j'ai déjà exploré plusieurs facettes de l'entrepreneuriat : e-commerce, création de contenu et développement de projets. Aujourd'hui, je souhaite mettre cette expérience au service d'une entreprise et continuer à apprendre sur le terrain.",
];
---

<section id="a-propos" class="section section--brume apropos" aria-labelledby="titre-apropos">
  <div class="conteneur apropos__grille">
    <h2 id="titre-apropos" class="titre-section">À propos</h2>
    <div>
      {paragraphes.map((p) => <p class="apropos__texte" set:html={typo(p)} />)}
      <a class="lien apropos__lien" href="#projets">Voir mes projets</a>
    </div>
  </div>
</section>

<style>
  .apropos__grille {
    display: grid;
    gap: 2rem;
  }

  .apropos__texte + .apropos__texte {
    margin-top: 1em;
  }

  .apropos__texte {
    max-width: 36ch;
    font-size: clamp(1.25rem, 0.95rem + 1.1vw, 2.125rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .apropos__lien {
    display: inline-block;
    margin-top: 1.75rem;
    font-weight: 600;
  }

  @media (min-width: 64em) {
    .apropos__grille {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
