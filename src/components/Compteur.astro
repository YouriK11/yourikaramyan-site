---
// A number that counts up once when it scrolls into view. The final value is in the HTML,
// so visitors without JS or with reduced motion see it at once. An invisible copy of the final
// value reserves the width, so counting never moves the text around it.
import { formaterNombre } from '../data/nombres';

interface Props {
  valeur: number;
  decimales?: number;
  /** "+" for "+500" (plus de 500). */
  prefixe?: string;
  suffixe?: string;
  /** What screen readers say, when the symbol would be read aloud ("~10" read as "Environ 10"). */
  lecture?: string;
}

const { valeur, decimales = 0, prefixe = '', suffixe = '', lecture } = Astro.props;
const suffixeAffiche = suffixe.replace(/ /g, ' ');
const texte = prefixe + formaterNombre(valeur, decimales) + suffixeAffiche;
---

<span
  class="compteur"
  data-compteur
  data-valeur={valeur}
  data-decimales={decimales}
  data-prefixe={prefixe}
  data-suffixe={suffixeAffiche}
>
  <span class="compteur__fantome" aria-hidden="true">{texte}</span>
  <span class="compteur__valeur" aria-hidden="true" data-compteur-valeur>{texte}</span>
  <span class="sr-only">{lecture ?? texte}</span>
</span>

<script>
  // No GSAP here on purpose: a small requestAnimationFrame loop is enough, and it keeps GSAP
  // in the hero's bundle only.
  import { formaterNombre } from '../data/nombres';

  const DUREE = 1600;
  const sortieDouce = (t: number) => 1 - (1 - t) ** 3;

  const compteurs = document.querySelectorAll<HTMLElement>('[data-compteur]');

  if (compteurs.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const ecrire = (el: HTMLElement, n: number) => {
      const sortie = el.querySelector<HTMLElement>('[data-compteur-valeur]');
      if (sortie) {
        sortie.textContent =
          (el.dataset.prefixe ?? '') + formaterNombre(n, Number(el.dataset.decimales ?? 0)) + (el.dataset.suffixe ?? '');
      }
    };

    const compter = (el: HTMLElement) => {
      const cible = Number(el.dataset.valeur);
      const pas = 10 ** Number(el.dataset.decimales ?? 0);
      const debut = performance.now();
      const image = (maintenant: number) => {
        const t = Math.min(1, (maintenant - debut) / DUREE);
        ecrire(el, Math.round(cible * sortieDouce(t) * pas) / pas);
        if (t < 1) requestAnimationFrame(image);
      };
      requestAnimationFrame(image);
    };

    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (!entree.isIntersecting) continue;
          observateur.unobserve(entree.target);
          compter(entree.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );

    compteurs.forEach((el) => {
      // Already on screen at load (restored scroll position): keep the final value instead of resetting it to 0
      const { top, bottom } = el.getBoundingClientRect();
      if (top < innerHeight && bottom > 0) return;
      ecrire(el, 0); // start from zero, otherwise the final value flashes before counting
      observateur.observe(el);
    });
  }
</script>

<style>
  .compteur {
    display: inline-grid;
    font-variant-numeric: tabular-nums;
  }

  .compteur > span:not(.sr-only) {
    grid-area: 1 / 1;
    text-align: start;
    white-space: nowrap;
  }

  .compteur__fantome {
    visibility: hidden;
  }
</style>
