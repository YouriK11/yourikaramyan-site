---
// Site footer. Kept short: the contact section above it carries the full details.
import { PROFIL } from '../data/profil';
import { SITE } from '../data/site';

const annee = new Date().getFullYear();
---

<footer class="pied sur-nuit">
  <div class="conteneur pied__barre">
    <p>© {annee} Youri Karamyan, {PROFIL.identite.lieu}</p>
    <ul role="list" class="pied__liens">
      <li><a href={PROFIL.contact.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={`mailto:${PROFIL.contact.email}`}>E-mail</a></li>
      <li><a href="#haut">Haut de page</a></li>
    </ul>
    {
      SITE.goatcounter && (
        <p class="pied__confidentialite">
          Ce site compte les visites avec GoatCounter, sans cookie et sans donnée personnelle.
        </p>
      )
    }
  </div>
</footer>

{
  SITE.goatcounter && (
    <script
      is:inline
      data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}

<style>
  .pied {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--texte-s);
  }

  .pied__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  .pied p {
    color: var(--brume-sur-nuit);
  }

  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .pied__confidentialite {
    flex-basis: 100%;
  }

  .pied__liens a {
    display: inline-block;
    padding-block: 0.375rem;
    text-decoration-line: underline;
    text-decoration-color: var(--abricot);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
