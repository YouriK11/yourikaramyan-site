---
// Timeline of every CV line, most recent first, grouped by starting year. Content comes from src/data/profil.ts only.
// Lines whose project has a panel in the "Projets" section (src/data/projets.ts) show no details here, only a
// "Voir le projet" link to it. The others keep their CV details.
// By default it shows the essentials for a marketing internship, plus the student jobs with their details (Youri
// wants his Quick Herstal line seen, 22/10/2026); "Voir tout le parcours" unfolds the rest. Without JavaScript,
// everything is shown.
import { PROFIL } from '../data/profil';
import { typo } from '../data/typographie';
import { PROJETS_AVEC_PANNEAU } from '../data/projets';

type Categorie = 'formation' | 'experience' | 'academique' | 'job';

interface Entree {
  categorie: Categorie;
  titre: string;
  lieu: string;
  periode: string;
  debut: number;
  fin: number | null;
  textes: string[];
  resultats: string[];
  lien?: { href: string; texte: string };
  essentiel: boolean;
}

const LIBELLES: Record<Categorie, string> = {
  formation: 'Formation',
  experience: 'Expérience',
  academique: 'Projet académique',
  job: 'Job étudiant',
};

// Shown before "Voir tout le parcours": MonArc, the e-commerce shop, both bachelor's degrees and the academic projects.
const ESSENTIELS = new Set([
  "Projet d'application mobile",
  'Boutique e-commerce',
  'Bachelier en E-Business',
  'Bachelier en Sciences de gestion',
]);

const entrees: Entree[] = [
  ...PROFIL.formation.map((f) => ({
    categorie: 'formation' as const,
    titre: f.titre,
    lieu: f.lieu,
    periode: f.periode,
    debut: f.debut,
    fin: f.fin,
    textes: [],
    resultats: [],
    essentiel: ESSENTIELS.has(f.titre),
  })),
  ...PROFIL.experiences.map((e) => ({
    categorie: 'experience' as const,
    titre: e.titre,
    lieu: [e.structure, e.detail].filter(Boolean).join(', '),
    periode: e.periode,
    debut: e.debut,
    fin: e.fin,
    ...(PROJETS_AVEC_PANNEAU.has(e.projet)
      ? { textes: [], resultats: [], lien: { href: `#${e.projet}`, texte: 'Voir le projet' } }
      : { textes: [...e.points], resultats: 'resultats' in e ? [...e.resultats] : [] }),
    essentiel: ESSENTIELS.has(e.titre),
  })),
  ...PROFIL.projetsAcademiques.map((p) => ({
    categorie: 'academique' as const,
    titre: p.titre,
    lieu: p.lieu,
    periode: p.periode,
    debut: p.debut,
    fin: p.fin,
    ...(PROJETS_AVEC_PANNEAU.has(p.projet)
      ? { textes: [], resultats: [], lien: { href: `#${p.projet}`, texte: 'Voir le projet' } }
      : { textes: [p.texte], resultats: [] }),
    essentiel: true,
  })),
];

// Most recent first: starting year, then whatever is still ongoing or ended later.
entrees.sort((a, b) => b.debut - a.debut || (b.fin ?? 9999) - (a.fin ?? 9999));

const groupes = [...new Set(entrees.map((e) => e.debut))].map((annee) => {
  const liste = entrees.filter((e) => e.debut === annee);
  return { annee, entrees: liste, essentiel: liste.some((e) => e.essentiel) };
});
---

<section id="parcours" class="section parcours" aria-labelledby="titre-parcours">
  <div class="conteneur">
    <div class="parcours__entete">
      <h2 id="titre-parcours" class="titre-section">Parcours</h2>
      <ul class="legende" role="list" aria-label="Légende de la frise">
        {
          (Object.keys(LIBELLES) as Categorie[]).map((c) => (
            <li>
              <span class={`pastille pastille--${c}`} aria-hidden="true" />
              {LIBELLES[c]}
            </li>
          ))
        }
      </ul>
    </div>

    <ol id="frise" class="frise" role="list" data-frise>
      {
        groupes.map((groupe) => (
          <li class="frise__annee" data-secondaire={groupe.essentiel ? undefined : ''}>
            <h3 class="frise__repere">{groupe.annee}</h3>
            <ol class="frise__entrees" role="list">
              {groupe.entrees.map((e) => (
                <li class="entree" data-secondaire={e.essentiel ? undefined : ''}>
                  <span class={`pastille pastille--${e.categorie} entree__pastille`} aria-hidden="true" />
                  <h4 class="entree__titre" set:html={typo(e.titre)} />
                  {e.lieu && <p class="entree__lieu" set:html={typo(e.lieu)} />}
                  <p class="entree__meta">
                    <span class="entree__categorie">{LIBELLES[e.categorie]}</span>
                    <span class="entree__periode" set:html={typo(e.periode)} />
                  </p>
                  {e.textes.length > 0 && (
                    <ul class="entree__textes" role="list">
                      {e.textes.map((t) => (
                        <li set:html={typo(t)} />
                      ))}
                    </ul>
                  )}
                  {e.resultats.length > 0 && (
                    <ul class="entree__resultats" role="list">
                      {e.resultats.map((r) => (
                        <li set:html={typo(r)} />
                      ))}
                    </ul>
                  )}
                  {e.lien && (
                    <a class="lien entree__lien" href={e.lien.href}>
                      {e.lien.texte}
                      <span class="sr-only"> : {e.titre}</span>
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))
      }
      <li class="frise__annee frise__annee--jobs">
        <h3 class="frise__repere frise__repere--jobs">Jobs étudiants</h3>
        <div class="frise__entrees">
          <div class="entree">
            <span class="pastille pastille--job entree__pastille" aria-hidden="true" />
            <ul class="jobs__details" role="list">
              {
                PROFIL.jobs.map((j) => (
                  <li>
                    <p>
                      <strong>{j.employeur}</strong>, <span set:html={typo(j.texte)} />
                    </p>
                    <p class="entree__meta">
                      <span class="entree__categorie">{LIBELLES.job}</span>
                      <span class="entree__periode" set:html={typo(j.periode)} />
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </li>
    </ol>

    <button class="bouton bouton--contour frise__bouton" type="button" aria-expanded="false" aria-controls="frise" hidden>
      Voir tout le parcours
    </button>
  </div>
</section>

<script>
  // Folded by default once JavaScript runs (html.js, set in Base.astro): the button unfolds the rest.
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  const bouton = document.querySelector<HTMLButtonElement>('.frise__bouton');
  if (frise && bouton) {
    bouton.hidden = false;
    bouton.addEventListener('click', () => {
      const complete = frise.classList.toggle('frise--complete');
      bouton.setAttribute('aria-expanded', String(complete));
      bouton.textContent = complete ? 'Réduire le parcours' : 'Voir tout le parcours';
      if (complete) {
        // Keyboard and screen reader users continue from the first unfolded year, already on screen.
        const cible = frise.querySelector<HTMLElement>('[data-secondaire] .frise__repere');
        if (cible) {
          cible.tabIndex = -1;
          cible.focus({ preventScroll: true });
        }
      } else {
        bouton.scrollIntoView({ block: 'nearest' });
      }
    });
  }
</script>

<style>
  .parcours__entete {
    display: grid;
    gap: 1.75rem;
  }

  /* Legend and markers: shape and colour both encode the category, and every entry also names it. */
  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.5rem;
    color: var(--ardoise);
    font-size: var(--texte-s);
  }

  .legende li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pastille {
    display: inline-block;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--nuit);
    border-radius: 50%;
    background: var(--nuit);
  }

  .pastille--experience {
    border-color: var(--abricot);
    background: var(--abricot);
  }

  .pastille--academique {
    background: var(--blanc);
  }

  .pastille--job {
    border-radius: 3px;
    border-color: var(--ardoise);
    background: var(--ardoise);
    transform: scale(0.8) rotate(45deg);
  }

  /* Timeline */
  .frise {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .frise__annee + .frise__annee {
    margin-top: 0.5rem;
  }

  .frise__repere {
    font-family: var(--police-titre);
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    font-weight: 760;
    font-stretch: 90%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .frise__entrees {
    position: relative;
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
    padding: 0.25rem 0 2.25rem 2rem;
  }

  /* The rail */
  .frise__entrees::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.375rem;
    width: 2px;
    border-radius: 1px;
    background: var(--trait);
  }

  .frise__annee:last-child .frise__entrees {
    padding-bottom: 0;
  }

  .entree {
    position: relative;
    max-width: 48rem;
  }

  .entree__pastille {
    position: absolute;
    top: 0.3rem;
    left: calc(-2rem + 0.375rem + 1px - 0.4375rem);
  }

  .entree__titre {
    font-size: clamp(1.125rem, 0.95rem + 0.35vw, 1.375rem);
    font-weight: 650;
    line-height: 1.35;
  }

  /* Folding: on screen only, and only once JavaScript can unfold it again. Paper always gets everything. */
  @media screen {
    :global(html.js) .frise:not(.frise--complete) [data-secondaire] {
      display: none;
    }
  }

  /* Student jobs */
  .frise__repere--jobs {
    font-size: var(--titre-3);
    line-height: 1.15;
  }

  .frise__annee--jobs .entree {
    max-width: none; /* each job holds on one line on a computer */
  }

  .jobs__details {
    display: grid;
    gap: 1rem;
  }

  .frise__bouton {
    margin-top: 2.5rem;
  }

  .entree__lieu {
    margin-top: 0.125rem;
  }

  .entree__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.375rem;
    color: var(--ardoise);
    font-size: var(--texte-s);
  }

  .entree__categorie {
    font-weight: 600;
  }

  .entree__textes,
  .entree__resultats {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .entree__textes li,
  .entree__resultats li {
    position: relative;
    padding-left: 1.125rem;
  }

  /* Small apricot square, as the CV's bullets */
  .entree__textes li::before,
  .entree__resultats li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 1px;
    background: var(--abricot);
  }

  .entree__resultats li {
    font-weight: 600;
  }

  .entree__lien {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
  }

  /* Desktop: large years in their own column, kept in view while their entries scroll by. */
  @media (min-width: 48em) {
    .parcours__entete {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    /* Shared by the timeline and the button below it */
    .parcours {
      --annee: clamp(2.75rem, 0.8rem + 3.6vw, 5rem);
    }

    .frise__annee {
      display: grid;
      grid-template-columns: calc(var(--annee) * 2.35 + 1.5rem) minmax(0, 1fr);
    }

    .frise__repere {
      position: sticky;
      top: calc(var(--hauteur-entete) + 1.5rem);
      align-self: start;
      font-size: var(--annee);
      font-weight: 800;
      font-stretch: 85%;
      letter-spacing: -0.02em;
    }

    .frise__repere--jobs {
      padding-top: 0.25rem;
      font-size: var(--titre-3);
      font-weight: 760;
      font-stretch: 92%;
      letter-spacing: 0;
    }

    .frise__bouton {
      margin-left: calc(var(--annee) * 2.35 + 1.5rem + 2.5rem);
    }

    .frise__annee + .frise__annee {
      margin-top: 0; /* one continuous rail from year to year */
    }

    .frise__entrees {
      margin-top: 0;
      padding-left: 2.5rem;
      padding-bottom: 2.75rem;
    }

    .entree__pastille {
      left: calc(-2.5rem + 0.375rem + 1px - 0.4375rem);
    }
  }
</style>
