---
// Trial pages only: one home variant, followed by the case study, on a dark page.
// Never indexed, never in the sitemap or the menu. Removed once Youri has chosen.
import Base from '../../layouts/Base.astro';
import Entete from '../Entete.astro';
import EtudeDeCas from '../EtudeDeCas.astro';
import PiedDePage from '../PiedDePage.astro';

interface Props {
  titre: string;
}

const { titre } = Astro.props;
---

<Base titre={`${titre} | Youri Karamyan`} noindex canonical={false}>
  <slot name="head" slot="head" />
  <Entete />
  <main id="contenu" class="essai">
    <slot />
    <EtudeDeCas />
  </main>
  <PiedDePage />
</Base>

<style is:global>
  /* Dark header on the trial pages only (:has(.essai) never matches on the real pages) */
  :root:has(.essai) {
    background: var(--nuit);
  }

  :root:has(.essai) .entete {
    border-bottom-color: rgb(255 255 255 / 0.1);
    background: var(--nuit);
    color: var(--blanc);
  }

  :root:has(.essai) .entete :focus-visible {
    outline-color: var(--abricot);
  }

  :root:has(.essai) .entete .bouton {
    border-color: var(--abricot);
    background: var(--abricot);
    color: var(--nuit);
  }

  /* The hero and the case study share the midnight blue: a hairline between them */
  :root:has(.essai) .etude {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  /* The hero variants are dark too: focus rings in apricot */
  .essai-accueil :focus-visible {
    outline-color: var(--abricot);
  }
</style>
